{
  "name": "@movogo-io/docs",
  "version": "0.0.6",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/movogo-io/node-docs.git"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "*.js",
    "lib/*.js",
    "*.d.ts",
    "lib/*.d.ts",
    "instructions.md"
  ],
  "exports": {
    ".": "./partitioned.js",
    "./indexed": "./indexed.js",
    "./schema": "./schema.js",
    "./driver": "./driver.js",
    "./test/memory": "./memory.js",
    "./test/harness": "./harness.js",
    "./test/mock": "./mock.js"
  },
  "ai": {
    "instructions": "./instructions.md"
  },
  "mock": "test/mock",
  "scripts": {
    "start": "riddance-watch",
    "prepack": "riddance-build",
    "prepublishOnly": "riddance-prepublish",
    "postpublish": "riddance-sync"
  },
  "devDependencies": {
    "@riddance/env": "0.10.0"
  }
}
